# Nectar SDK — PX4 SITL indoor (GPS-denied) parameters
#
# Applied via start_px4.sh --params px4_indoor.env as PX4_PARAM_* exports
# (PX4's env override mechanism). Analogue of indoor.parm for ArduPilot.
#
# Pose-only EV by default (bits 0,1,3 = 11). Use EKF2_EV_CTRL=15 when also
# feeding velocity (vision_pose_node send_speed:=true).

# Disable GNSS aiding indoors
EKF2_GPS_CTRL=0

# External vision: horizontal pos + vertical pos + yaw (no velocity)
EKF2_EV_CTRL=11

# Height reference = Vision
EKF2_HGT_REF=3

# Do not fuse magnetometer when yaw comes from vision
EKF2_MAG_TYPE=5

# Allow arming without a GPS fix (SITL indoor)
COM_ARM_WO_GPS=1
