# Nectar SDK — PX4 SITL outdoor (GNSS) parameters
#
# Applied via start_px4.sh for outdoor_field_px4 (or --params px4_outdoor.env).
# Restores stock GNSS EKF after indoor runs: PX4 persists CAL_*/EKF2_* in
# build/.../rootfs/parameters.bson, so EKF2_GPS_CTRL=0 from px4_indoor.env would
# otherwise leave the estimator in CONST_POS with no horizontal aiding.
# Defaults: params_gnss.yaml, module.yaml (EKF2_HGT_REF), params_magnetometer.yaml,
# commander_params.yaml (COM_ARM_WO_GPS). Override mechanism:
# https://docs.px4.io/main/en/simulation/#environment-variables

# Lon/lat + altitude + 3D velocity GNSS aiding
EKF2_GPS_CTRL=7

# No external vision outdoors
EKF2_EV_CTRL=0

# Height reference = GPS
EKF2_HGT_REF=1

# Automatic magnetometer fusion
EKF2_MAG_TYPE=0

# PX4 default: allow arm with warning if GNSS check fails
COM_ARM_WO_GPS=1
