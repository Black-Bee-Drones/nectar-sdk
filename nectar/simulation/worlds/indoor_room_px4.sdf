<?xml version="1.0" ?>
<!--
  Nectar SDK — indoor room world for PX4 SITL (Gazebo Harmonic).

  Mirrors the ArduPilot indoor arena (indoor_room_scenery, 20×20×12 m) so both
  firmwares fly the same GPS-denied room. The drone is not embedded — PX4 spawns
  x500_nectar at startup (matched sensors). Physics / Sensors / IMU systems are
  injected by PX4's server.config, so this file stays scenery-only (no world
  system plugins). Ground-truth pose for external vision comes from the
  PosePublisher attached to x500_nectar (model-level; Gazebo 8 requirement).

  Discovery: install_px4.sh symlinks this file into PX4_GZ_WORLDS so PX4 can
  start it via PX4_GZ_WORLD=indoor_room_px4. Ground-truth pose comes from the
  PosePublisher on x500_nectar (Gazebo 8 requires model-level attachment).

  Usage:
    PX4_GZ_WORLD=indoor_room_px4 PX4_SIM_MODEL=gz_x500_nectar \
      PX4_GZ_MODEL_POSE="-5,0,0.2" make px4_sitl
-->
<sdf version="1.9">
  <world name="indoor_room_px4">

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.6 0.6 0.6</ambient>
      <background>0.2 0.2 0.2</background>
      <shadows>true</shadows>
    </scene>

    <!-- PosePublisher lives on x500_nectar (model-level) — Gazebo 8 rejects
         world-attached PosePublisher ("should be attached to a model entity").
         px4_sitl.launch.py bridges /model/x500_nectar/pose → gz_vision_source. -->

    <!-- ── GUI — same camera feeds as outdoor_field_px4 / ArduPilot indoor ── -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.2 0.2 0.2</background_color>
        <camera_pose>-5 0 8 0 0.8 0</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">145</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>false</iterations>
      </plugin>
      <plugin filename="ImageDisplay" name="Front Camera RGB">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
        <topic>/front_camera/image</topic>
      </plugin>
      <plugin filename="ImageDisplay" name="Front Camera Depth">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
        <topic>/front_camera/depth_image</topic>
      </plugin>
      <plugin filename="ImageDisplay" name="Down Camera">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
        <topic>/down_camera</topic>
      </plugin>
      <plugin filename="TopicEcho" name="Topic Echo">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- Indoor: no NavSat / spherical GPS origin required for EV flight.
         Keep a near-zero-declination origin so mag (if briefly used before
         EKF2_MAG_TYPE=None takes effect) does not skew yaw. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>40.0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Indoor lighting (4 lights to cover 20×20 m room) -->
    <light type="point" name="ceiling_light_1">
      <pose>-5 -5 11.5 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>30</range>
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.003</quadratic>
      </attenuation>
    </light>
    <light type="point" name="ceiling_light_2">
      <pose>-5 5 11.5 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>30</range>
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.003</quadratic>
      </attenuation>
    </light>
    <light type="point" name="ceiling_light_3">
      <pose>5 -5 11.5 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>30</range>
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.003</quadratic>
      </attenuation>
    </light>
    <light type="point" name="ceiling_light_4">
      <pose>5 5 11.5 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>30</range>
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.003</quadratic>
      </attenuation>
    </light>

    <!-- Shared scenery (enclosed room + obstacles) — same as ArduPilot indoor -->
    <include>
      <uri>model://indoor_room_scenery</uri>
    </include>

    <!-- Drone is NOT embedded; PX4 spawns x500_nectar at startup
         (PX4_SIM_MODEL=gz_x500_nectar, PX4_GZ_MODEL_POSE=-5,0,0.2). -->

  </world>
</sdf>
